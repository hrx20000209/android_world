<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.androidworld.fasta11y">
  <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="36" />

  <application
      android:label="Fast A11y Dumper"
      android:allowBackup="false"
      android:supportsRtl="true">
    <service
        android:name=".FastA11yService"
        android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
        android:exported="false">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
          android:name="android.accessibilityservice"
          android:resource="@xml/fast_a11y_service" />
    </service>

    <provider
        android:name=".FastA11yProvider"
        android:authorities="com.androidworld.fasta11y.provider"
        android:exported="true"
        android:grantUriPermissions="true" />
  </application>
</manifest>
